# ==============================================================================
# PROJECTFORGE AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Authentication & Security
# Generate a strong 32+ character random secret for production
JWT_SECRET=projectforge_super_secure_jwt_token_secret_key_2026_dev
JWT_EXPIRES_IN=7d

# Database Configuration
# If MONGODB_URI is provided, ProjectForge connects directly to MongoDB Atlas or local MongoDB.
# If omitted, ProjectForge automatically uses the built-in high-performance persistent embedded JSON engine!
MONGODB_URI=
DATA_DIR=./data

# AI Provider Configuration
# Supported providers: "gemini", "openai", "groq", or "deterministic" (offline fallback)
AI_PROVIDER=deterministic
AI_API_KEY=

# Optional Provider Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Rate Limits (Requests per minute per IP)
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20
